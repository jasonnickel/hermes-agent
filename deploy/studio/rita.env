# rita.env - NON-SECRET runtime config for the Rita/Hermes gateway on the Mac Studio.
# Secrets are NOT stored here; they are fetched from Infisical at launch by
# rita-gateway.sh. This file is safe to commit (no credentials).
# Ported from the retired openclaw-vm ~/.hermes/.env (2026-07-09 migration),
# secret keys removed.

# --- Terminal / sandbox tool ---
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# --- Browser tool ---
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120

# --- Debug flags ---
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# --- Slack access policy (not secret) ---
SLACK_ALLOWED_USERS=*
SLACK_ALLOW_ALL_USERS=false
SLACK_REQUIRE_MENTION=false
SLACK_HOME_CHANNEL=C0AL98E7UMD
SLACK_HOME_CHANNEL_NAME=nickel-ops

# --- Home Assistant endpoint (token is a secret, fetched from Infisical) ---
HOME_ASSISTANT_URL=http://192.168.68.103:8123

# --- Codex OAuth refresh timeout ---
HERMES_CODEX_REFRESH_TIMEOUT_SECONDS=45
